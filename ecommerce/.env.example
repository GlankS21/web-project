# Copy this file to .env and replace every "change-me" value before starting the stack.
# Values must not be quoted. Avoid spaces and the characters @ : / # in passwords
# (they are embedded in connection URLs).

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me-postgres-admin
POSTGRES_PORT=5432

# One dedicated role per service database (role names are fixed: auth_user, user_user, ...)
AUTH_DB_PASSWORD=change-me-auth-db
USER_DB_PASSWORD=change-me-user-db
PRODUCT_DB_PASSWORD=change-me-product-db
INVENTORY_DB_PASSWORD=change-me-inventory-db
CART_DB_PASSWORD=change-me-cart-db
ORDER_DB_PASSWORD=change-me-order-db
PAYMENT_DB_PASSWORD=change-me-payment-db
NOTIFICATION_DB_PASSWORD=change-me-notification-db

# ---------------------------------------------------------------- RabbitMQ
RABBITMQ_USERNAME=shop
RABBITMQ_PASSWORD=change-me-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ---------------------------------------------------------------- Config server (HTTP Basic)
CONFIG_SERVER_USERNAME=config
CONFIG_SERVER_PASSWORD=change-me-config
CONFIG_SERVER_PORT=8888

# ---------------------------------------------------------------- Eureka (HTTP Basic)
EUREKA_USERNAME=eureka
EUREKA_PASSWORD=change-me-eureka
DISCOVERY_SERVER_PORT=8761

# ---------------------------------------------------------------- JWT (HS256)
# Base64 key of at least 256 bits. Generate: openssl rand -base64 64
JWT_SECRET=change-me-generate-with-openssl-rand-base64-64

# ---------------------------------------------------------------- Initial administrator (Flyway seed)
# Do not use single quotes in these values.
ADMIN_EMAIL=admin@shop.local
ADMIN_PASSWORD=change-me-Admin123

# ---------------------------------------------------------------- API gateway
API_GATEWAY_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Shared secret between the frontend and the gateway, so the gateway rate-limits per browser rather
# than per frontend container. Generate with: openssl rand -base64 32 | tr -d '\r\n'
TRUSTED_PROXY_SECRET=change-me-generate-a-random-value
# Per-client rate limiting (login/register 10 per minute); false only for local experiments
RATE_LIMIT_ENABLED=true

# ---------------------------------------------------------------- Frontend
FRONTEND_PORT=3000
# Reverse proxies (nginx, load balancer) in front of the frontend that append to X-Forwarded-For;
# 0 = browsers connect to the frontend directly
TRUSTED_PROXY_HOPS=0
# Address of the shop as customers open it; used for the links in e-mails (password reset)
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------- Catalogue
# ISO 4217 code of every product price (optional, default RUB; online payments accept RUB only)
CATALOG_CURRENCY=RUB

# ---------------------------------------------------------------- Payments
# mock: local imitation of the payment page (no account needed)
# yookassa: test shop of YooKassa, see README "Оплата через ЮKassa"
PAYMENT_PROVIDER=mock
# Shop id and secret key (test_...) from the YooKassa dashboard, only for PAYMENT_PROVIDER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ---------------------------------------------------------------- E-mail (notification-service)
# Docker: Mailpit catches every e-mail, web UI on http://localhost:8025
# Local run: the service talks to Mailpit on localhost:1025 (docker compose up -d mailpit)
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
MAIL_FROM=no-reply@shop.local
SHOP_NAME=TechShop
