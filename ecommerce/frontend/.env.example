# Copy to .env.local for "npm run dev" (Docker Compose sets these itself).

# Where the server side of the frontend reaches the API gateway. The browser never calls it directly.
API_GATEWAY_URL=http://localhost:8080

# Same value as TRUSTED_PROXY_SECRET of the gateway: lets the gateway rate-limit per browser
# instead of treating the whole frontend as one client. Leave empty to disable.
TRUSTED_PROXY_SECRET=

# Number of reverse proxies (nginx, load balancer) in front of the frontend that append to
# X-Forwarded-For. 0 = browsers connect directly to the frontend.
TRUSTED_PROXY_HOPS=0
