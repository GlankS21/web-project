+package com.shop.common.util;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+
+/**
+ * Percentage arithmetic with the rounding used for money.
+ */
+public final class Percentages {
+
+    private static final BigDecimal HUNDRED = BigDecimal.valueOf(100);
+
+    private Percentages() {
+    }
+
+    public static BigDecimal of(BigDecimal amount, BigDecimal percent) {
+        return amount.multiply(percent).divide(HUNDRED, 2, RoundingMode.HALF_UP);
+    }
+}
